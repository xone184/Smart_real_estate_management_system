# ====================================
# Environment Variables for SmartRE
# ====================================

# Application Settings
NODE_ENV=development
APP_URL=http://localhost:8080
APP_NAME="Smart Real Estate Management System"

# Frontend - Vite
VITE_API_BASE_URL=/smart-real-estate-management-system/api
VITE_UPLOAD_BASE_URL=/smart-real-estate-management-system/uploads
VITE_GROQ_API_KEY=your_groq_api_key_here

# Backend - PHP Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root_password
DB_NAME=smartre_db

# SMTP Configuration - Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME="Smart Real Estate"

# CORS Configuration (comma-separated domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Security
APP_ENV=development
DEBUG=true

# Firebase Configuration (Optional)
FIREBASE_API_KEY=your_firebase_key
FIREBASE_AUTH_DOMAIN=your_firebase_domain
FIREBASE_PROJECT_ID=your_firebase_project_id
