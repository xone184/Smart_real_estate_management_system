{
  "name": "SmartRE Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/var/www/html/smart-real-estate-management-system",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "forwardPorts": [3000, 8080, 3306],
  "portsAttributes": {
    "3000": { "label": "Vite Frontend", "onAutoForward": "openBrowser" },
    "8080": { "label": "Apache PHP API", "onAutoForward": "silent" },
    "3306": { "label": "MySQL", "onAutoForward": "ignore" }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
