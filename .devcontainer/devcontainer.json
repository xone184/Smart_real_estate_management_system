{
  "name": "SmartRE",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Vite Frontend", "onAutoForward": "openBrowser" },
    "8080": { "label": "PHP Server", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
