{
  "name": "SmartRE",
  "image": "mcr.microsoft.com/devcontainers/php:8.2-apache",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/robbert229/devcontainer-features/mysql-mariadb:1": {
      "version": "10.11"
    }
  },

  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Vite Frontend", "onAutoForward": "openBrowser" },
    "8080": { "label": "Apache PHP API", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
